---
// 過刊瀏覽列表（中英共用）
import Colophon from './Colophon.astro';
import Masthead from './Masthead.astro';
import { fmt } from '../lib/dateCn.mjs';
import { langPrefix } from '../lib/i18n.mjs';
import BASE from '../lib/base.mjs';
import { tidy } from '../lib/tidy.mjs';
interface Props {
  rows: { date: string; issueNo: number; headline: string }[];
  lang: 'zh' | 'en';
  t: any;
  latestDate: string;
  altHref?: string | null;
}
const { rows, lang, t, latestDate, altHref } = Astro.props;
const f = fmt(lang);
const p = `${BASE}${langPrefix(lang)}`;
---
<Masthead issueNo={rows[0]?.issueNo ?? 1} date={latestDate} t={t} altHref={altHref} />
<section class="archive">
  <h2 class="archive-title">{t.archiveTitle}</h2>
  { rows.length === 0 && <p class="archive-empty">{t.archiveEmpty}</p> }
  <ul class="archive-list">
    {rows.map(r => (
      <li>
        <a href={`${p}issue/${r.date}/`}>
          <span class="archive-issue">{f.issue(r.issueNo)}</span>
          <span class="archive-date">{f.date(r.date)}</span>
          <span class="archive-headline">{tidy(r.headline)}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
<Colophon issueNo={rows[0]?.issueNo ?? 1} prevDate={null} t={t} />
