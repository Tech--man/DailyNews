---
// 版尾
import { cnIssue } from '../lib/dateCn.mjs';
interface Props { issueNo: number; prevDate?: string | null }
const { issueNo, prevDate } = Astro.props;
const issueCn = cnIssue(issueNo);
---
<footer class="colophon">
  <p>本報文字均整理自公開報導，僅存標題與摘要；原文版權歸各來源所有。本版為靜態排印試驗，不代表任何機構立場。</p>
  <p class="colophon-nav">
    {issueCn} ·
    {prevDate ? <a href={`/issue/${prevDate}/`}>上一期</a> : <span>已是最早一期</span>} ·
    <a href="/">回到頭版</a>
  </p>
  <p class="colophon-fine">每日新報 Daily News · 復古排印試驗 · 零腳本靜態頁面</p>
</footer>
