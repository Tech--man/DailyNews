---
// 版尾
import { fmt } from '../lib/dateCn.mjs';
import BASE from '../lib/base.mjs';
import { langPrefix } from '../lib/i18n.mjs';
interface Props { issueNo: number; prevDate?: string | null; t: any; nextDate?: string | null }
const { issueNo, prevDate, t, nextDate } = Astro.props;
const lang = t.htmlLang === 'en' ? 'en' : 'zh';
const f = fmt(lang);
const p = `${BASE}${langPrefix(lang)}`;
---
<footer class="colophon">
  <p>{t.disclaimer}</p>
  <p class="colophon-nav">
    {f.issue(issueNo)} ·
    {prevDate ? <a href={`${p}issue/${prevDate}/`}>{t.prevIssue}</a> : <span>{t.earliest}</span>} ·
    <a href={`${p}archive/`}>{t.archiveTitle}</a> ·
    <a href={p}>{t.backHome}</a>
  </p>
  <p class="colophon-fine">{t.colophonFine}</p>
</footer>
