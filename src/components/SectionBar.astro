---
// 欄目條：由當日期數據驅動——只列出實際有稿的欄目，並錨點跳轉。
// v1 硬編碼六個欄目名，與實際版面（只有財經/科技）不一致，屬視覺誤導。
interface Props {
  sections: { key: string; label: string }[];
  ariaLabel?: string;
}
const { sections, ariaLabel = 'Sections' } = Astro.props;
---
{ sections.length > 0 && (
<nav class="sections" aria-label={ariaLabel}>
  <ul>
    {sections.map(s => <li><a href={`#sec-${s.key}`}>{s.label}</a></li>)}
  </ul>
</nav>
) }
