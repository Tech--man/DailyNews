---
// 副刊 · 廣告位。有副刊文章走雙欄，否則僅廣告框居中。
import { cnIssue } from '../lib/dateCn.mjs';
interface Props { issueNo: number; supplement?: { title: string; paragraphs: string[] } | null }
const { issueNo, supplement } = Astro.props;
const adonly = !supplement;
---
<section class:list={['supplement', { 'supplement--adonly': adonly }]}>
  { supplement && (
    <div class="supplement-main">
      <p class="supplement-kicker">副刊</p>
      <h3 class="supplement-title">{supplement.title}</h3>
      {supplement.paragraphs.map(p => <p>{p}</p>)}
    </div>
  ) }
  <div class="ad-box">
    <p class="ad-head">訂閱啟事</p>
    <p class="ad-body">本報每日清晨六時出版，薈集當日新聞要目與各版精華。全年訂閱價洋拾元正，郵費在內；零售每份貳角。訂戶請向各地郵局或報房接洽。</p>
    <p class="ad-sign">廣告部謹啟</p>
    <div class="seal" aria-hidden="true">
      <span class="seal-name">每日<br>新報</span>
      <span class="seal-issue">{cnIssue(issueNo)}</span>
    </div>
  </div>
</section>
