---
// 過刊瀏覽（中文版）
import Page from '../layouts/Page.astro';
import Archive from '../components/Archive.astro';
import { listIssueDates, loadIssue } from '../lib/issues.mjs';
import { t } from '../lib/i18n.mjs';
import BASE from '../lib/base.mjs';

const dates = listIssueDates();
const rows = dates.map(d => {
  const it = loadIssue(d);
  return { date: d, issueNo: it.issue, headline: it.editions?.zh?.headline?.title ?? '' };
});
const T = t('zh');
const altHref = `${BASE}en/archive/`;
---
<Page title={`${T.pageTitle} · ${T.archiveTitle}`} lang="zh" altHref={altHref}>
  <Archive rows={rows} lang="zh" t={T} latestDate={dates[0]} altHref={altHref} />
</Page>
