---
// 頭版（中文版 · 最新一期）
import Page from '../layouts/Page.astro';
import FrontPage from '../components/FrontPage.astro';
import { latestIssue, listIssueDates } from '../lib/issues.mjs';
import { t } from '../lib/i18n.mjs';
import { cnDate } from '../lib/dateCn.mjs';
import BASE from '../lib/base.mjs';

const { date, issue } = latestIssue();
const prevDate = listIssueDates().find(d => d !== date) ?? null;
const T = t('zh');
const altHref = `${BASE}en/`;
---
<Page
  title={`${T.pageTitle} · ${cnDate(date)}`}
  lang="zh"
  description={T.description}
  ogImage={`/og/${date}.png`}
  ogDescription={issue.editions?.zh?.headline?.title}
  altHref={altHref}
>
  <FrontPage issue={issue} date={date} lang="zh" t={T} prevDate={prevDate} altHref={altHref} />
</Page>
