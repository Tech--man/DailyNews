---
// 指定期次（中文版）
import Page from '../../layouts/Page.astro';
import FrontPage from '../../components/FrontPage.astro';
import { listIssueDates, loadIssue } from '../../lib/issues.mjs';
import { t } from '../../lib/i18n.mjs';
import { cnDate } from '../../lib/dateCn.mjs';
import BASE from '../../lib/base.mjs';

export function getStaticPaths() {
  return listIssueDates().map(date => ({ params: { date } }));
}

const { date } = Astro.params;
const issue = loadIssue(date!);
const dates = listIssueDates();
const idx = dates.indexOf(date!);
const prevDate = dates[idx + 1] ?? null;
const T = t('zh');
const altHref = `${BASE}en/issue/${date}/`;
---
<Page
  title={`${T.pageTitle} · ${cnDate(date!)}`}
  lang="zh"
  description={T.description}
  ogImage={`/og/${date}.png`}
  ogDescription={issue.editions?.zh?.headline?.title}
  altHref={altHref}
>
  <FrontPage issue={issue} date={date!} lang="zh" t={T} prevDate={prevDate} altHref={altHref} />
</Page>
